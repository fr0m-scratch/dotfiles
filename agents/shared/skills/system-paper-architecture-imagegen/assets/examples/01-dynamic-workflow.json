    {"id": "DW-06", "from": "scheduler", "to": "fork", "label": "dispatch isolated branches", "tone": "red", "style": "solid"},

    {"id": "DW-07", "from": "fork", "to": "reader_a", "label": "supporting-evidence query", "tone": "blue", "style": "solid"},
    {"id": "DW-08", "from": "fork", "to": "reader_b", "label": "independent-source query", "tone": "blue", "style": "solid"},
    {"id": "DW-09", "from": "fork", "to": "counter", "label": "conditional counter-query", "tone": "blue", "style": "dashed"},
    {"id": "DW-10", "from": "reader_a", "to": "artifact_join", "label": "supporting ArtifactRef", "tone": "blue", "style": "solid"},
    {"id": "DW-11", "from": "reader_b", "to": "artifact_join", "label": "independent ArtifactRef", "tone": "blue", "style": "solid"},
    {"id": "DW-12", "from": "counter", "to": "artifact_join", "label": "counter-evidence ArtifactRef", "tone": "blue", "style": "dashed"},
    {"id": "DW-13", "from": "artifact_join", "to": "coder_tools", "label": "typed evidence + coding objective", "tone": "blue", "style": "solid"},
    {"id": "DW-14", "from": "artifact_join", "to": "specialist", "label": "typed evidence + domain query", "tone": "blue", "style": "solid"},
    {"id": "DW-15", "from": "coder_tools", "to": "final_join", "label": "code + tool receipts", "tone": "blue", "style": "solid"},
    {"id": "DW-16", "from": "specialist", "to": "final_join", "label": "domain review artifact", "tone": "blue", "style": "solid"},
    {"id": "DW-17", "from": "final_join", "to": "writer", "label": "schema-complete ArtifactRef set", "tone": "blue", "style": "solid"},
    {"id": "DW-18", "from": "writer", "to": "candidate", "label": "candidate ArtifactRef", "tone": "blue", "style": "solid"},
    {"id": "DW-19", "from": "coder_tools", "to": "event_log", "label": "tool request + result receipts", "tone": "blue", "style": "solid"},

    {"id": "DW-20", "from": "candidate", "to": "verification", "label": "mandatory independent checks", "tone": "ink", "style": "solid"},
    {"id": "DW-21", "from": "task_contract", "to": "verification", "label": "immutable checker contract", "tone": "ink", "style": "dashed"},
    {"id": "DW-22", "from": "verification", "to": "acceptance", "label": "proof + verifier + policy receipts", "tone": "green", "style": "solid"},
    {"id": "DW-23", "from": "acceptance", "to": "commit", "label": "PASS · reversible", "tone": "green", "style": "solid"},
    {"id": "DW-24", "from": "acceptance", "to": "human_gate", "label": "PASS · approval required", "tone": "green", "style": "dashed"},
    {"id": "DW-25", "from": "human_gate", "to": "commit", "label": "APPROVE", "tone": "green", "style": "solid"},
    {"id": "DW-26", "from": "acceptance", "to": "recovery", "label": "FAIL · typed rejection", "tone": "red", "style": "dashed"},
    {"id": "DW-27", "from": "human_gate", "to": "stop", "label": "REJECT / TIMEOUT", "tone": "red", "style": "dashed"},
    {"id": "DW-28", "from": "recovery", "to": "graph_compiler", "label": "repair + replan directive", "tone": "red", "style": "dashed"},
    {"id": "DW-29", "from": "recovery", "to": "stop", "label": "unrecoverable / budget exhausted", "tone": "red", "style": "dashed"},
    {"id": "DW-30", "from": "commit", "to": "event_log", "label": "commit receipt + outcome", "tone": "green", "style": "solid"},

    {"id": "DW-31", "from": "event_log", "to": "trajectory", "label": "auditable runtime evidence", "tone": "purple", "style": "dashed"},
    {"id": "DW-32", "from": "trajectory", "to": "credit_search", "label": "failure labels + outcome evidence", "tone": "purple", "style": "solid"},
    {"id": "DW-33", "from": "credit_search", "to": "offline_canary", "label": "candidate policy + rollback plan", "tone": "purple", "style": "solid"},
    {"id": "DW-34", "from": "offline_canary", "to": "versioned_policy", "label": "PASS · promote", "tone": "purple", "style": "solid"},
    {"id": "DW-35", "from": "offline_canary", "to": "prior_policy", "label": "FAIL · keep known-good", "tone": "purple", "style": "dashed"},
    {"id": "DW-36", "from": "versioned_policy", "to": "graph_compiler", "label": "released signed PolicyRef", "tone": "purple", "style": "dashed"}
  ],
  "forbidden_edges": [
    {"from": "reader_a", "to": "counter", "reason": "counter-evidence must be an independent fork branch"},
    {"from": "writer", "to": "commit", "reason": "the generator cannot certify or commit its own output"},
    {"from": "candidate", "to": "commit", "reason": "every candidate must pass independent verification and acceptance"},
    {"from": "acceptance", "to": "stop", "reason": "failed checks first produce a typed recovery decision; the gate cannot silently stop"},
    {"from": "stop", "to": "commit", "reason": "rejection and timeout are terminal, never commit paths"},
    {"from": "versioned_policy", "to": "scheduler", "reason": "offline learning may update only the graph compiler through a released policy"},
    {"from": "versioned_policy", "to": "commit", "reason": "learning never owns effect authority"},
    {"from": "prior_policy", "to": "trajectory", "reason": "rollback selects a known-good policy; it does not reverse evidence flow"}
  ],
  "layout_notes": [
    "Place Control on the left, Execution in the broad center, Assurance on the right, and Learning as a full-width bottom band.",
    "Reserve an outer perimeter lane for FAIL to Recovery and Versioned Policy to Graph Compiler.",
    "Keep the three fork branches parallel and visually independent before they converge at the typed artifact join.",
    "Put PASS reversible, PASS approval required, FAIL, APPROVE, and REJECT / TIMEOUT labels directly beside distinct branches.",
    "Place each required detail phrase inside its corresponding node; keep detail text compact and subordinate to the node label."
  ],
  "required_text": [
    "objective · acceptance · risk class",
    "decomposability · verifiability · coupling · risk",
    "nodes · edges · bindings",
    "allowed rewrites · cost · deadline",
    "dispatch · bind · cancel",
    "repair · retry · replan · rollback",
    "supporting evidence",
    "independent source",
    "conditional branch",
    "hash · schema · producer · provenance · permissions",
    "scoped capability · tool receipts",
    "independent review",
    "required inputs only",
    "proposes only",
    "untrusted proposal",
    "events · receipts · outcomes",
    "deterministic oracle · claim verifier · security policy",
    "all required receipts must pass",
    "irreversible effects only",
    "authorized effect",
    "failures and successes",
    "node and edge credit · candidate policy",
    "held-out suite · guarded rollout",
    "released signed PolicyRef",
    "known-good rollback target"
  ]
}
