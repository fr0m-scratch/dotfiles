{
  "title": "1 · Dynamic Workflow Runtime",
  "purpose": "Show a mutable task graph in which control compiles topology, execution produces typed artifacts, independent assurance owns commit, and offline learning can only publish a versioned policy back to the graph compiler.",
  "caption": "Scale verified context branches, not agent headcount.",
  "canvas": {
    "aspect": "16:9 landscape",
    "background": "warm near-white paper"
  },
  "style": {
    "medium": "conference-paper hand-drawn architecture diagram with thin imperfect marker lines and highly legible English labels",
    "palette": "warm near-white paper; charcoal ink; red control; blue execution; green assurance; purple offline learning"
  },
  "zones": [
    {"id": "control", "label": "CONTROL PLANE", "tone": "red"},
    {"id": "execution", "label": "EXECUTION PLANE", "tone": "blue"},
    {"id": "assurance", "label": "ASSURANCE PLANE", "tone": "green"},
    {"id": "learning", "label": "LEARNING PLANE · OFFLINE", "tone": "purple"}
  ],
  "nodes": [
    {"id": "task_contract", "label": "Task + Contract", "zone": "control", "kind": "input"},
    {"id": "profiler", "label": "Task Profiler", "zone": "control", "kind": "process"},
    {"id": "graph_compiler", "label": "Graph Compiler", "zone": "control", "kind": "compiler"},
    {"id": "policy_budget", "label": "Topology Policy + Budget", "zone": "control", "kind": "policy"},
    {"id": "scheduler", "label": "Scheduler", "zone": "control", "kind": "scheduler"},
    {"id": "recovery", "label": "Recovery Controller", "zone": "control", "kind": "controller"},
    {"id": "stop", "label": "STOP / REJECT", "zone": "control", "kind": "terminal"},

    {"id": "fork", "label": "Task Graph Fork", "zone": "execution", "kind": "fork"},
    {"id": "reader_a", "label": "Reader A", "zone": "execution", "kind": "worker"},
    {"id": "reader_b", "label": "Reader B", "zone": "execution", "kind": "worker"},
    {"id": "counter", "label": "Counter-Evidence", "zone": "execution", "kind": "worker"},
    {"id": "artifact_join", "label": "Typed Artifact Bus + Join", "zone": "execution", "kind": "join"},
    {"id": "coder_tools", "label": "Coder + Sandboxed Tools", "zone": "execution", "kind": "tool actor"},
    {"id": "specialist", "label": "Domain Specialist", "zone": "execution", "kind": "worker"},
    {"id": "final_join", "label": "Final Typed Join", "zone": "execution", "kind": "join"},
    {"id": "writer", "label": "Writer", "zone": "execution", "kind": "generator"},
    {"id": "candidate", "label": "Candidate Artifact", "zone": "execution", "kind": "artifact"},
    {"id": "event_log", "label": "Append-Only Event Log", "zone": "execution", "kind": "append-only store"},

    {"id": "verification", "label": "Independent Verification", "zone": "assurance", "kind": "verifier"},
    {"id": "acceptance", "label": "Acceptance Gate", "zone": "assurance", "kind": "gate"},
    {"id": "human_gate", "label": "Human Gate", "zone": "assurance", "kind": "human gate"},
    {"id": "commit", "label": "Commit", "zone": "assurance", "kind": "effect"},

    {"id": "trajectory", "label": "Trajectory + Outcome", "zone": "learning", "kind": "dataset"},
    {"id": "credit_search", "label": "Credit + Workflow Search", "zone": "learning", "kind": "optimizer"},
    {"id": "offline_canary", "label": "Offline Eval + Canary", "zone": "learning", "kind": "release gate"},
    {"id": "versioned_policy", "label": "Versioned Policy", "zone": "learning", "kind": "policy artifact"},
    {"id": "prior_policy", "label": "Prior Policy", "zone": "learning", "kind": "policy artifact"}
  ],
  "edges": [
    {"id": "DW-01", "from": "task_contract", "to": "profiler", "label": "task + acceptance contract", "tone": "ink", "style": "solid"},
    {"id": "DW-02", "from": "profiler", "to": "graph_compiler", "label": "typed state profile", "tone": "red", "style": "solid"},
    {"id": "DW-03", "from": "policy_budget", "to": "graph_compiler", "label": "topology rules + compile budget", "tone": "red", "style": "solid"},
    {"id": "DW-04", "from": "graph_compiler", "to": "scheduler", "label": "versioned graph + bindings", "tone": "red", "style": "solid"},
