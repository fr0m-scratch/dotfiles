#!/usr/bin/env bash
set -euo pipefail

KEYCHAIN_SERVICE="codex-api-keys"

NAMES=(
  "OpenAI:OPENAI_API_KEY"
  "Claude/Anthropic:ANTHROPIC_API_KEY"
  "DeepSeek 1:DEEPSEEK_API_KEY"
  "DeepSeek 2:DEEPSEEK_API_KEY_2"
  "GLM/Zhipu:GLM_API_KEY"
  "GLM Coding 1:GLM_CODING_API_KEY"
  "GLM Coding 2:GLM_CODING_API_KEY_2"
  "Kimi Code 1:KIMI_API_KEY"
  "Kimi Code 2:KIMI_API_KEY_2"
  "Kimi Code 3:KIMI_API_KEY_3"
  "LiteLLM:LITELLM_API_KEY"
  "LiteLLM Base URL:LITELLM_BASE_URL"
  "Notion:NOTION_API_KEY"
  "Lark App ID:LARK_APP_ID"
  "Lark App Secret:LARK_APP_SECRET"
  "Fireworks:FIREWORKS_API_KEY"
  "MiniMax:MINIMAX_API_KEY"
  "Exa Search:EXA_API_KEY"
  "Tavily Search:TAVILY_API_KEY"
  "Volcengine App ID:VOLC_APP_ID"
  "Volcengine Access Token:VOLC_ACCESS_KEY"
  "Volcengine Secret Key:VOLC_SECRET_KEY"
  "Aliyun Key ID:ALIBABA_CLOUD_ACCESS_KEY_ID"
  "Aliyun Key Secret:ALIBABA_CLOUD_ACCESS_KEY_SECRET"
  "Webull App Key:WEBULL_APP_KEY"
  "Webull App Secret:WEBULL_APP_SECRET"
  "Tailscale API:TAILSCALE_API_KEY"
  "Tailscale Auth Key:TAILSCALE_AUTHKEY"
  "OpenBao Addr:BAO_ADDR"
  "OpenBao Token:BAO_TOKEN"
)

# Kimi and GLM each serve several live, auth-gated roots and a given key is
# valid on exactly one family of them: a Kimi Code subscription answers on
# api.kimi.com/coding/v1 while Moonshot platform keys answer on
# api.moonshot.{cn,ai}/v1; a GLM Coding Plan key answers on the .../coding/paas/v4
# roots while a Zhipu platform key answers on the plain .../paas/v4 roots.
# `test` probes these in order and reports the root that accepted the key --
# that root is the api_root to put in a provider config. The Anthropic-wire
# equivalents (for ANTHROPIC_BASE_URL) are:
#   Kimi Code   https://api.kimi.com/coding
#   GLM         https://open.bigmodel.cn/api/anthropic  |  https://api.z.ai/api/anthropic
KIMI_API_ROOTS=(
  "https://api.kimi.com/coding/v1"
  "https://api.moonshot.cn/v1"
  "https://api.moonshot.ai/v1"
)

GLM_CODING_API_ROOTS=(
  "https://open.bigmodel.cn/api/coding/paas/v4"
  "https://api.z.ai/api/coding/paas/v4"
  "https://open.bigmodel.cn/api/paas/v4"
  "https://api.z.ai/api/paas/v4"
)

GLM_PLATFORM_API_ROOTS=(
  "https://open.bigmodel.cn/api/paas/v4"
  "https://api.z.ai/api/paas/v4"
)

MINIMAX_API_ROOTS=(
  "https://api.minimaxi.com/v1"
  "https://api.minimax.chat/v1"
  "https://api.minimax.io/v1"
)

# DeepSeek serves one root (the documented `/v1` suffix is an alias of it kept for
# OpenAI-SDK compatibility, not a second family), named once because both slots
# probe it.
DEEPSEEK_API_ROOTS=(
  "https://api.deepseek.com"
)

# Webull is one API behind a dozen regional hosts, and a key issued for one
# region is rejected by the others, so `test` probes in order and reports the
# host that answered -- that host is the endpoint to configure. The full table,
# from the SDK's own webull/core/data/endpoints.json:
#   us api.webull.com     hk api.webull.hk      jp api.webull.co.jp
#   sg api.webull.com.sg  th api.webull.co.th   au api.webull.com.au
#   my api.webull.com.my  uk api.webull-uk.com  eu api.webull.eu
#   br, mx -> us hosts    za -> au hosts
# Sandbox mirrors production under api.sandbox.webull.com. Set WEBULL_API_HOST
# to probe one host instead of this list.
WEBULL_API_HOSTS=(
  "api.webull.com"
  "api.sandbox.webull.com"
  "api.webull.hk"
  "api.webull.co.jp"
)

# The docs' signature page specifies HMAC-SHA1 while the current SDK (2.0.16)
# overrides every request to HMAC-SHA256. Credentials that do not exist draw the
# same 401 either way, so which one an account's host accepts cannot be settled
# without a real key: send the SDK's first, fall back to the documented one, and
# report which one answered.
WEBULL_SIGN_ALGORITHMS=(
  "HMAC-SHA256"
  "HMAC-SHA1"
)

# OpenBao is the odd entry here: it is not a provider, it is the shared secret
# manager the other keys can be published TO (`pool --sync-bao`). It earns a slot
# because its token is a credential like any other -- it expires, it can be revoked,
# and until now the only copy lived in a bare file that nothing checked. The names
# are BAO_ADDR / BAO_TOKEN because that is what OpenBao's own CLI reads, so
# `eval "$(api_keys export bao)"` is enough to run `bao` against it.
#
# The ADDRESS is deliberately a Keychain entry rather than a constant: this
# repository is public, and where one company's secret manager lives is not
# something a public dotfiles repo should state. `test` resolves it from
# env -> Keychain -> ~/.api-keys-bao, so an existing pool config keeps working and
# a machine with neither is simply reported as unconfigured.
usage() {
  cat <<'EOF'
Usage:
  api_keys set      [KEY...]   Prompt for keys and save them to macOS Keychain
  api_keys template [KEY...]   Print a blank NAME=value block to fill in
  api_keys import   [FILE]     Save a pasted/piped NAME=value block (stdin default)
  api_keys export   [KEY...]   Print shell exports for saved keys
  api_keys pool     [KEY...]   Print exports binding each provider's canonical name
                               to a slot that can serve right now
  api_keys test     [KEY...]   Test saved keys against lightweight API endpoints
  api_keys list     [KEY...]   Show which keys are saved, with a safe fingerprint
  api_keys delete   [KEY...]   Delete saved keys from macOS Keychain

KEY selects one entry; with no KEY every entry is used. A selector matches the
environment variable (KIMI_API_KEY), its provider prefix (kimi), or the display
label ("Kimi Code 1"), case-insensitively. A prefix covering several variables
selects all of them (kimi -> KIMI_API_KEY + KIMI_API_KEY_2 + KIMI_API_KEY_3).

Recommended:
  api_keys set
  eval "$(api_keys export)"
  api_keys test

Add or replace a single key without re-prompting the rest:
  api_keys set kimi_api_key_2 && api_keys test kimi_api_key_2

Paste several keys in one go (nothing is written until you close the input):
  api_keys import
  KIMI_API_KEY_2=sk-...
  KIMI_API_KEY_3=sk-...
  <Ctrl-D>

Or fill in a template and pipe it back:
  api_keys template kimi glm litellm > /tmp/keys.txt   # edit, then:
  api_keys import /tmp/keys.txt && rm -P /tmp/keys.txt

POOL — several keys for one provider, one name for the consumer:
  eval "$(api_keys pool)"      DEEPSEEK_API_KEY gets whichever DeepSeek slot can
                               serve right now; same for the Kimi and GLM slots.
  api_keys pool --refresh deepseek        re-probe instead of trusting the cache
  api_keys pool --sync-bao deepseek       also publish the winner to the shared
                                          secret manager (cas-guarded, read back)
OPENBAO — the manager itself is an entry, not just a destination:
  api_keys set bao            store BAO_ADDR and BAO_TOKEN
  api_keys test openbao       is it sealed, what does the token grant, when does it
                              expire, and can it actually read the shared records
  eval "$(api_keys export bao)"   BAO_ADDR/BAO_TOKEN are what the `bao` CLI reads
`pool --sync-bao` uses these slots too, falling back to ~/.api-keys-bao.

The decision is cached at ~/.api-keys-pool for 12 h (API_KEYS_POOL_TTL_SECS);
the cache holds slot names and digests, never a key. Replacing a key changes its
digest and invalidates the entry by itself. `export` stays literal: it dumps every
slot as stored, while `pool` answers "which one works".

`export` and `pool` print nothing when stdout is a terminal or the caller is a
coding agent, because in neither case is anything eval-ing the value -- it would
just be left in scrollback or in a transcript. `pool` still reports its choice on
stderr. Override with --force, or API_KEYS_ALLOW_STDOUT=1 for a consumer that
swallows the value immediately.
EOF
}

get_key() {
  local env_name="$1"
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$env_name" -w 2>/dev/null
}

# --------------------------------------------------------------------------------
# Printing a value to stdout is the one thing this tool does that leaves a secret
# somewhere it can be read again. `eval "$(api_keys export)"` needs it there, so the
# emission cannot go away -- but the two cases where nobody is eval-ing anything can
# be refused:
#   - stdout is a terminal      the value lands in scrollback and screen shares
#   - an agent is the caller    the value lands in a session transcript, which is
#                               how DEEPSEEK_API_KEY_2 leaked on 2026-08-12, hours
#                               after it was bought
# A consumer that really does swallow the value immediately (core-connect) says so
# with API_KEYS_ALLOW_STDOUT=1; a human who wants to read it says --force.
# --------------------------------------------------------------------------------
FORCE_STDOUT=0

stdout_is_recorded() {
  [[ "$FORCE_STDOUT" -eq 1 ]] && return 1
  [[ "${API_KEYS_ALLOW_STDOUT:-0}" == "1" ]] && return 1
  [[ -t 1 ]] && return 0
  [[ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CURSOR_AGENT:-}" ]] && return 0
  return 1
}

refuse_stdout() {
  local verb="$1"

  printf 'api_keys %s: refusing to print key values here.\n' "$verb" >&2
  if [[ -t 1 ]]; then
    printf '  stdout is a terminal, so the value would sit in scrollback.\n' >&2
  else
    printf '  this is an agent session, so the value would be kept in a transcript.\n' >&2
  fi
  printf '  eval "$(api_keys %s)" in your own shell, or --force to print anyway.\n' "$verb" >&2
}

get_key_or_env() {
  local env_name="$1"
  local value="${!env_name:-}"

  if [[ -n "$value" ]]; then
    printf "%s" "$value"
    return 0
  fi

  get_key "$env_name"
}

has_key() {
  local env_name="$1"
  security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$env_name" -w >/dev/null 2>&1
}

shell_quote() {
  local value="$1"
  printf "'%s'" "${value//\'/\'\\\'\'}"
}

lower() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

upper() {
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]'
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

# A length plus a truncated digest: enough to confirm a paste landed and to spot
# the same key pasted into two slots, without ever putting the secret on screen.
fingerprint() {
  local value="$1" digest
  digest="$(printf '%s' "$value" | shasum -a 256 | cut -c1-8)"
  printf '%d chars, sha256:%s' "${#value}" "$digest"
}

digest_of() {
  printf '%s' "$1" | shasum -a 256 | cut -c1-8
}

# A selector is what a person types, and the name of a thing is not always the
# prefix of its variables. OpenBao's own CLI reads BAO_ADDR/BAO_TOKEN, but nobody
# calls the product "bao" -- so map the spoken name onto the variable prefix rather
# than letting `api_keys test openbao` fail on a name that is obviously right.
selector_alias() {
  case "$1" in
    openbao) printf 'bao' ;;
    aliyun|ali|阿里云|阿里) printf 'alibaba_cloud' ;;
    *) printf '%s' "$1" ;;
  esac
}

# Print the NAMES entries matching each selector, one per line.
resolve_selectors() {
  local sel item label env_name norm_sel norm_env norm_label hit rc=0

  for sel in "$@"; do
    norm_sel="$(selector_alias "$(lower "$sel")")"
    hit=0
    for item in "${NAMES[@]}"; do
      label="${item%%:*}"
      env_name="${item##*:}"
      norm_env="$(lower "$env_name")"
      norm_label="$(lower "$label")"

      if [[ "$norm_sel" == "$norm_env" ]] \
        || [[ "$norm_sel" == "${norm_env%_api_key}" ]] \
        || [[ "$norm_sel" == "$norm_label" ]] \
        || [[ "$norm_env" == "$norm_sel"_* ]]; then
        printf '%s\n' "$item"
        hit=1
      fi
    done

    if [[ "$hit" -eq 0 ]]; then
      printf 'Unknown key selector: %s\n' "$sel" >&2
      rc=1
    fi
  done

  return "$rc"
}

# Populate SELECTED with the entries a command should act on: everything when no
# selector is given, otherwise just the resolved ones. Exits on a bad selector so
# a typo never silently degrades into "operate on all keys".
SELECTED=()
select_items() {
  local resolved item

  SELECTED=()

  if [[ "$#" -eq 0 ]]; then
    for item in "${NAMES[@]}"; do
      SELECTED+=("$item")
    done
    return 0
  fi

  resolved="$(resolve_selectors "$@")" || {
    printf 'Run `api_keys list` to see the available names.\n' >&2
    exit 2
  }

  while IFS= read -r item; do
    [[ -n "$item" ]] && SELECTED+=("$item")
  done <<EOF
$resolved
EOF

  if [[ "${#SELECTED[@]}" -eq 0 ]]; then
    printf 'No keys selected.\n' >&2
    exit 2
  fi
}

cmd_set() {
  local item label env_name secret existing

  select_items "$@"

  echo "Paste each API key at the prompt. Input is hidden. Press Enter on an empty prompt to skip."
  echo

  for item in "${SELECTED[@]}"; do
    label="${item%%:*}"
    env_name="${item##*:}"

    existing=""
    if has_key "$env_name"; then
      existing=" [already saved; paste a new value to replace]"
    fi

    printf "%s (%s)%s: " "$label" "$env_name" "$existing" >&2
    IFS= read -r -s secret
    printf "\n" >&2

    if [[ -z "$secret" ]]; then
      echo "Skipped $env_name"
      continue
    fi

    save_key "$env_name" "$secret"
  done
}

save_key() {
  local env_name="$1" secret="$2"

  security add-generic-password \
    -U \
    -s "$KEYCHAIN_SERVICE" \
    -a "$env_name" \
    -w "$secret" >/dev/null

  printf 'Saved %s (%s)\n' "$env_name" "$(fingerprint "$secret")"
}

cmd_template() {
  local item label env_name

  select_items "$@"

  cat <<'EOF'
# Fill in a value after each '='. Blank lines, '#' comments and empty values are
# ignored, so leave any slot you are not setting alone. Then:
#   api_keys import THIS_FILE && rm -P THIS_FILE
# The file holds plaintext secrets until you delete it.
EOF

  for item in "${SELECTED[@]}"; do
    label="${item%%:*}"
    env_name="${item##*:}"
    printf '\n# %s\n%s=\n' "$label" "$env_name"
  done
}

# Read NAME=value lines and save each one. Nothing touches the Keychain until the
# whole block has been read and every name resolved, so a typo in line 3 cannot
# leave you with a half-applied paste.
cmd_import() {
  local src="${1:-}"
  local line name value item env_name known
  local names=() values=() blanks=()
  local unknown=0 count=0 i j

  if [[ -n "$src" ]]; then
    if [[ ! -r "$src" ]]; then
      printf 'Cannot read %s\n' "$src" >&2
      exit 2
    fi
    exec <"$src"
  elif [[ -t 0 ]]; then
    echo "Paste NAME=value lines, one per line, then press Ctrl-D." >&2
    echo "Input is echoed by the terminal; run in a window you can clear afterwards." >&2
    echo >&2
  fi

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="$(trim "$line")"
    [[ -z "$line" ]] && continue
    case "$line" in \#*) continue ;; esac
    line="${line#export }"

    if [[ "$line" == *"="* ]]; then
      name="${line%%=*}"
      value="${line#*=}"
    elif [[ "$line" == *":"* ]]; then
      name="${line%%:*}"
      value="${line#*:}"
    else
      printf 'Ignored (no NAME=value): %s\n' "$line" >&2
      unknown=1
      continue
    fi

    name="$(upper "$(trim "$name")")"
    value="$(trim "$value")"
    # Tolerate a quoted value, the shape `api_keys export` emits.
    case "$value" in
      \'*\') value="${value#\'}"; value="${value%\'}" ;;
      \"*\") value="${value#\"}"; value="${value%\"}" ;;
    esac

    # A template line left blank is normal, but a name whose value went missing
    # in the paste looks exactly the same, so say which ones came through empty
    # instead of dropping them without a word.
    if [[ -z "$value" ]]; then
      blanks[${#blanks[@]}]="$name"
      continue
    fi

    known=0
    for item in "${NAMES[@]}"; do
      env_name="${item##*:}"
      if [[ "$name" == "$env_name" ]]; then
        known=1
        break
      fi
    done

    if [[ "$known" -eq 0 ]]; then
      printf 'Unknown key name: %s\n' "$name" >&2
      unknown=1
      continue
    fi

    # Two lines for one slot means the second silently wins and one key is lost
    # without a trace -- the exact way a multi-account paste goes wrong.
    i=0
    while [[ "$i" -lt "$count" ]]; do
      if [[ "${names[$i]}" == "$name" ]]; then
        printf 'Duplicate name in this block: %s appears twice.\n' "$name" >&2
        printf 'Each slot takes one key -- did you mean a different slot for the second?\n' >&2
        unknown=1
      fi
      i=$((i + 1))
    done

    names[$count]="$name"
    values[$count]="$value"
    count=$((count + 1))
  done

  if [[ "${#blanks[@]}" -gt 0 ]]; then
    printf 'Empty value, nothing saved for: %s\n' "${blanks[*]}" >&2
  fi

  if [[ "$unknown" -eq 1 ]]; then
    printf 'Nothing was saved. Run `api_keys list` to see the available names.\n' >&2
    exit 2
  fi

  if [[ "$count" -eq 0 ]]; then
    echo "No values found. Nothing saved." >&2
    exit 2
  fi

  i=0
  while [[ "$i" -lt "$count" ]]; do
    save_key "${names[$i]}" "${values[$i]}"
    i=$((i + 1))
  done

  # Pasting the same account into two slots is the failure this whole flow
  # exists to avoid, so say it out loud rather than leaving it to `list`.
  i=0
  while [[ "$i" -lt "$count" ]]; do
    j=$((i + 1))
    while [[ "$j" -lt "$count" ]]; do
      if [[ "${values[$i]}" == "${values[$j]}" ]]; then
        printf 'Warning: %s and %s hold the same key.\n' "${names[$i]}" "${names[$j]}" >&2
      fi
      j=$((j + 1))
    done
    i=$((i + 1))
  done
}

cmd_export() {
  local item env_name value

  if [[ "${1:-}" == "--force" ]]; then
    FORCE_STDOUT=1
    shift
  fi

  select_items "$@"

  if stdout_is_recorded; then
    refuse_stdout export
    return 2
  fi

  for item in "${SELECTED[@]}"; do
    env_name="${item##*:}"
    if value="$(get_key "$env_name")"; then
      printf "export %s=%s\n" "$env_name" "$(shell_quote "$value")"
    fi
  done
}

cmd_list() {
  local item label env_name value digest note
  local seen_digests=() seen_names=() i

  select_items "$@"

  for item in "${SELECTED[@]}"; do
    label="${item%%:*}"
    env_name="${item##*:}"

    if ! has_key "$env_name"; then
      printf "%-18s %-21s missing\n" "$label" "$env_name"
      continue
    fi

    value="$(get_key "$env_name")"

    # A base URL is not a secret and is the thing you actually need to eyeball.
    case "$env_name" in
      *_BASE_URL|BAO_ADDR)
        printf "%-18s %-21s saved  %s\n" "$label" "$env_name" "$value"
        continue
        ;;
    esac

    digest="$(digest_of "$value")"
    note=""
    i=0
    while [[ "$i" -lt "${#seen_digests[@]}" ]]; do
      if [[ "${seen_digests[$i]}" == "$digest" ]]; then
        note="  <- same key as ${seen_names[$i]}"
        break
      fi
      i=$((i + 1))
    done
    seen_digests[${#seen_digests[@]}]="$digest"
    seen_names[${#seen_names[@]}]="$env_name"

    printf "%-18s %-21s saved  (%s)%s\n" \
      "$label" "$env_name" "$(fingerprint "$value")" "$note"
  done
}

print_test_result() {
  local name="$1"
  local status="$2"
  local detail="${3:-}"

  if [[ "$status" == "200" ]]; then
    printf "%-18s OK\n" "$name"
  elif [[ "$status" == "MISSING" ]]; then
    printf "%-18s MISSING\n" "$name"
  elif [[ "$status" == "CURL_ERROR" ]]; then
    printf "%-18s FAIL curl/network error%s\n" "$name" "${detail:+ ($detail)}"
  else
    printf "%-18s FAIL HTTP %s%s\n" "$name" "$status" "${detail:+ ($detail)}"
  fi
}

http_get_bearer() {
  local name="$1"
  local env_name="$2"
  local url="$3"
  shift 3

  local key status tmp curl_rc
  if ! key="$(get_key_or_env "$env_name")" || [[ -z "$key" ]]; then
    print_test_result "$name" "MISSING"
    return 0
  fi

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
    -H "Authorization: Bearer $key" \
    "$@" \
    "$url" 2>/dev/null)"
  curl_rc=$?
  set -e
  rm -f "$tmp"

  if [[ "$curl_rc" -ne 0 ]]; then
    print_test_result "$name" "CURL_ERROR" "curl exit $curl_rc"
  else
    print_test_result "$name" "$status"
  fi
}

http_post_json_bearer() {
  local name="$1"
  local env_name="$2"
  local url="$3"
  local data="$4"
  shift 4

  local key status tmp curl_rc
  if ! key="$(get_key_or_env "$env_name")" || [[ -z "$key" ]]; then
    print_test_result "$name" "MISSING"
    return 0
  fi

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 30 -o "$tmp" -w "%{http_code}" \
    -X POST \
    -H "Authorization: Bearer $key" \
    -H "Content-Type: application/json" \
    "$@" \
    --data "$data" \
    "$url" 2>/dev/null)"
  curl_rc=$?
  set -e
  rm -f "$tmp"

  if [[ "$curl_rc" -ne 0 ]]; then
    print_test_result "$name" "CURL_ERROR" "curl exit $curl_rc"
  else
    print_test_result "$name" "$status"
  fi
}

# Anthropic answers /v1/models with 200 on an account whose balance is spent and
# only fails at /v1/messages, with 400 rather than the 402 you would expect.
http_get_anthropic() {
  local key status tmp curl_rc detail
  if ! key="$(get_key_or_env ANTHROPIC_API_KEY)" || [[ -z "$key" ]]; then
    print_test_result "Claude/Anthropic" "MISSING"
    return 0
  fi

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 60 -o "$tmp" -w "%{http_code}" \
    -X POST \
    -H "x-api-key: $key" \
    -H "anthropic-version: 2023-06-01" \
    -H "Content-Type: application/json" \
    --data '{"model":"claude-haiku-4-5-20251001","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}' \
    "https://api.anthropic.com/v1/messages" 2>/dev/null)"
  curl_rc=$?
  set -e

  if [[ "$curl_rc" -ne 0 ]]; then
    rm -f "$tmp"
    print_test_result "Claude/Anthropic" "CURL_ERROR" "curl exit $curl_rc"
    return 0
  fi

  if [[ "$status" == "200" ]]; then
    rm -f "$tmp"
    print_test_result "Claude/Anthropic" "200"
    return 0
  fi

  if is_quota_error "$tmp"; then
    detail="$(api_error_message "$tmp")"
    rm -f "$tmp"
    printf "%-18s NO QUOTA  https://api.anthropic.com -- key is valid, account cannot serve: %s\n" \
      "Claude/Anthropic" "$detail"
    return 0
  fi

  detail="$(api_error_message "$tmp")"
  rm -f "$tmp"
  print_test_result "Claude/Anthropic" "$status" "$detail"
}

http_test_lark() {
  # Lark/Feishu auth = app_id + app_secret -> tenant_access_token.
  # Note: Lark returns HTTP 200 even for bad creds, with a non-zero "code" in the body,
  # so we must inspect the body code, not just the HTTP status.
  local app_id app_secret status tmp curl_rc code
  app_id="$(get_key_or_env LARK_APP_ID || true)"
  app_secret="$(get_key_or_env LARK_APP_SECRET || true)"

  if [[ -z "$app_id" || -z "$app_secret" ]]; then
    print_test_result "Lark" "MISSING"
    return 0
  fi

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
    -X POST -H "Content-Type: application/json" \
    --data "{\"app_id\":\"$app_id\",\"app_secret\":\"$app_secret\"}" \
    "${LARK_DOMAIN:-https://open.larksuite.com}/open-apis/auth/v3/tenant_access_token/internal" 2>/dev/null)"
  curl_rc=$?
  set -e

  if [[ "$curl_rc" -ne 0 ]]; then
    print_test_result "Lark" "CURL_ERROR" "curl exit $curl_rc"
  elif [[ "$status" == "200" ]] && grep -q '"code"[[:space:]]*:[[:space:]]*0' "$tmp"; then
    print_test_result "Lark" "200"
  else
    code="$(grep -o '"code"[[:space:]]*:[[:space:]]*[0-9]*' "$tmp" | head -1)"
    print_test_result "Lark" "$status" "${code:-auth failed}"
  fi
  rm -f "$tmp"
}

# Percent-encode everything outside the unreserved set. printf %q is shell
# quoting, not URL quoting, and bash 3.2 has no better primitive, so this walks
# the string; what gets signed here is short and ASCII.
urlencode() {
  local string="$1" out="" len i c
  len="${#string}"
  i=0

  while [[ "$i" -lt "$len" ]]; do
    c="${string:$i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out="$out$c" ;;
      *) out="$out$(printf '%%%02X' "'$c")" ;;
    esac
    i=$((i + 1))
  done

  printf '%s' "$out"
}

# Webull signs the request rather than presenting the secret: no endpoint takes
# an App Secret, so `test` has to reproduce the algorithm exactly or it cannot
# tell a wrong secret from a wrong implementation. Checked against the worked
# example on the docs' signature page (path /trade/place_order, App Secret
# 0f50a2e8...c1f, expected signature kvlS6opdZDhEBo5jq40nHYXaLvM=).
# The signing key is the App Secret with a trailing '&'; the secret is never
# sent as a header.
webull_signature() {
  local secret="$1" algo="$2" string_to_sign="$3" digest

  case "$algo" in
    HMAC-SHA256) digest="sha256" ;;
    HMAC-SHA1) digest="sha1" ;;
    *) return 1 ;;
  esac

  urlencode "$string_to_sign" |
    openssl dgst -"$digest" -hmac "$secret&" -binary |
    openssl base64 -A
}

# One signed GET against the instrument list -- the lightest call that a plain
# App Key + App Secret can make. Trading and account calls additionally carry the
# 2FA x-access-token issued through the Webull app, which this deliberately does
# not touch. Results come back in these globals.
WEBULL_STATUS=""
WEBULL_CODE=""
WEBULL_DETAIL=""
webull_probe_once() {
  local host="$1" algo="$2" app_key="$3" app_secret="$4"
  local path="/openapi/instrument/stock/list"
  local query="symbols=AAPL&category=US_STOCK&page_size=1"
  local timestamp nonce signed signature tmp status curl_rc

  WEBULL_STATUS=""
  WEBULL_CODE=""
  WEBULL_DETAIL=""

  timestamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  nonce="$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')"

  # Query parameters and signing headers go into one collection, sorted by name
  # and joined name=value with '&', prefixed by the path. A GET has no body, so
  # no body digest is appended. Host is signed; curl sets it from the URL.
  signed="$(printf '%s\n' \
    "category=US_STOCK" \
    "host=$host" \
    "page_size=1" \
    "symbols=AAPL" \
    "x-app-key=$app_key" \
    "x-signature-algorithm=$algo" \
    "x-signature-nonce=$nonce" \
    "x-signature-version=1.0" \
    "x-timestamp=$timestamp" | LC_ALL=C sort | tr '\n' '&')"
  signed="$path&${signed%&}"

  if ! signature="$(webull_signature "$app_secret" "$algo" "$signed")"; then
    WEBULL_STATUS="SIGN_ERROR"
    WEBULL_DETAIL="unsupported signature algorithm $algo"
    return 0
  fi

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
    -H "x-app-key: $app_key" \
    -H "x-timestamp: $timestamp" \
    -H "x-signature: $signature" \
    -H "x-signature-algorithm: $algo" \
    -H "x-signature-version: 1.0" \
    -H "x-signature-nonce: $nonce" \
    -H "x-version: v2" \
    "https://$host$path?$query" 2>/dev/null)"
  curl_rc=$?
  set -e

  if [[ "$curl_rc" -ne 0 ]]; then
    rm -f "$tmp"
    WEBULL_STATUS="CURL_ERROR"
    WEBULL_DETAIL="curl exit $curl_rc"
    return 0
  fi

  WEBULL_STATUS="$status"
  WEBULL_CODE="$(json_field "$tmp" error_code)"
  WEBULL_DETAIL="$(api_error_message "$tmp")"
  rm -f "$tmp"
}

http_test_webull() {
  local app_key app_secret host algo
  local hosts=() last_status="" last_detail=""

  app_key="$(get_key_or_env WEBULL_APP_KEY || true)"
  app_secret="$(get_key_or_env WEBULL_APP_SECRET || true)"

  if [[ -z "$app_key" || -z "$app_secret" ]]; then
    print_test_result "Webull" "MISSING"
    return 0
  fi

  if [[ -n "${WEBULL_API_HOST:-}" ]]; then
    hosts=("$WEBULL_API_HOST")
  else
    hosts=("${WEBULL_API_HOSTS[@]}")
  fi

  for host in "${hosts[@]}"; do
    for algo in "${WEBULL_SIGN_ALGORITHMS[@]}"; do
      webull_probe_once "$host" "$algo" "$app_key" "$app_secret"

      if [[ "$WEBULL_STATUS" == "200" ]]; then
        printf "%-18s OK        %s (%s)\n" "Webull" "$host" "$algo"
        return 0
      fi

      # 401 is Webull's one answer to a wrong App Key, a wrong App Secret, an
      # unaccepted algorithm and a key from another region alike -- signing with
      # credentials that do not exist and sending an outright garbage signature
      # both return the same UNAUTHORIZED body. So a 401 rules out this
      # host+algorithm and nothing more; keep probing.
      if [[ "$WEBULL_STATUS" == "401" || "$WEBULL_STATUS" == "CURL_ERROR" \
        || "$WEBULL_STATUS" == "SIGN_ERROR" ]]; then
        last_status="$WEBULL_STATUS"
        last_detail="$host${WEBULL_DETAIL:+: $WEBULL_DETAIL}"
        continue
      fi

      # Anything else is past the 401 gate: the credentials were recognised and
      # the call itself was refused -- entitlement, IP allow-list, rate limit.
      printf "%-18s DENIED    %s (%s) -- credentials passed auth, call refused: HTTP %s%s%s\n" \
        "Webull" "$host" "$algo" "$WEBULL_STATUS" \
        "${WEBULL_CODE:+ $WEBULL_CODE}" "${WEBULL_DETAIL:+ -- $WEBULL_DETAIL}"
      return 0
    done
  done

  print_test_result "Webull" "$last_status" \
    "no host accepted the credentials; last $last_detail"
}

# --------------------------------------------------------------------------------
# ALIYUN
#
# Like Webull, the secret is an HMAC key that is never transmitted, so `test` has to
# reproduce Alibaba Cloud's RPC signature exactly or it cannot tell a wrong secret
# from a wrong implementation. Verified against the worked example on the signature
# page (AccessKeyId testid / AccessKeySecret testsecret, DescribeDedicatedHosts,
# nonce edb2b34af0af9a6d14deaf7c1a5315eb, timestamp 2023-03-13T08:34:30Z ->
# 9NaGiOspFP5UPcwX8Iwt2YJXXuk=), which `aliyun_signature_selftest` re-checks.
#
#   StringToSign = GET&%2F&<the canonicalized query, percent-encoded AGAIN>
#   canonicalized query = every parameter except Signature, sorted by name,
#                         each name and value percent-encoded, joined k=v with &
#   HMAC-SHA1, key = AccessKeySecret + "&", base64, then URL-encoded into the query
#
# Alibaba Cloud calls this signature version deprecated in favour of V3
# (ACS3-HMAC-SHA256); it is still accepted, and a 400 naming SignatureVersion is
# what would say otherwise -- the probe prints the returned Code, so that failure
# would be legible rather than mysterious.
ALIYUN_STS_HOST="sts.aliyuncs.com"

aliyun_signature() {
  local secret="$1" string_to_sign="$2"

  printf '%s' "$string_to_sign" |
    openssl dgst -sha1 -hmac "$secret&" -binary |
    openssl base64 -A
}

# Build the canonicalized query from name=value lines on stdin, then sign it.
# Returns the full query string with Signature appended.
ALIYUN_QUERY=""
aliyun_sign_query() {
  local secret="$1"
  shift
  local pair name value canonical="" string_to_sign signature

  # Sorting by the raw name is the same order as sorting by the encoded name here:
  # every parameter name is unreserved ASCII.
  while IFS= read -r pair; do
    [[ -z "$pair" ]] && continue
    name="${pair%%=*}"
    value="${pair#*=}"
    canonical="${canonical:+$canonical&}$(urlencode "$name")=$(urlencode "$value")"
  done <<EOF
$(printf '%s\n' "$@" | LC_ALL=C sort)
EOF

  string_to_sign="GET&$(urlencode "/")&$(urlencode "$canonical")"
  signature="$(aliyun_signature "$secret" "$string_to_sign")"
  ALIYUN_QUERY="$canonical&Signature=$(urlencode "$signature")"
  return 0
}

# The published vector, re-derived on every run of the probe. A signing routine
# that has drifted must not be allowed to report FAIL on someone's key: that would
# blame the credential for the code's mistake.
aliyun_signature_selftest() {
  local expected="9NaGiOspFP5UPcwX8Iwt2YJXXuk=" got

  aliyun_sign_query "testsecret" \
    "AccessKeyId=testid" \
    "Action=DescribeDedicatedHosts" \
    "Format=JSON" \
    "RegionId=cn-beijing" \
    "SignatureMethod=HMAC-SHA1" \
    "SignatureNonce=edb2b34af0af9a6d14deaf7c1a5315eb" \
    "SignatureVersion=1.0" \
    "Timestamp=2023-03-13T08:34:30Z" \
    "Version=2014-05-26"

  got="${ALIYUN_QUERY##*&Signature=}"
  [[ "$got" == "$(urlencode "$expected")" ]]
}

# GetCallerIdentity is the one call every valid AccessKey can make: it needs no RAM
# permission at all, so a refusal is about the credential and nothing else. It also
# names the identity, which is what tells a RAM user apart from a root account key.
http_test_aliyun() {
  local key_id secret tmp status curl_rc code message arn account identity_type

  if ! key_id="$(get_key_or_env ALIBABA_CLOUD_ACCESS_KEY_ID)" || [[ -z "$key_id" ]]; then
    print_test_result "Aliyun" "MISSING"
    return 0
  fi

  if ! secret="$(get_key_or_env ALIBABA_CLOUD_ACCESS_KEY_SECRET)" || [[ -z "$secret" ]]; then
    printf "%-18s MISSING   key id is saved, secret is not\n" "Aliyun"
    return 0
  fi

  if ! aliyun_signature_selftest; then
    printf "%-18s FAIL      signing self-test failed; not blaming your key\n" "Aliyun"
    return 0
  fi

  aliyun_sign_query "$secret" \
    "AccessKeyId=$key_id" \
    "Action=GetCallerIdentity" \
    "Format=JSON" \
    "SignatureMethod=HMAC-SHA1" \
    "SignatureNonce=$(uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]')" \
    "SignatureVersion=1.0" \
    "Timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    "Version=2015-04-01"

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
    "https://$ALIYUN_STS_HOST/?$ALIYUN_QUERY" 2>/dev/null)"
  curl_rc=$?
  set -e

  if [[ "$curl_rc" -ne 0 ]]; then
    rm -f "$tmp"
    print_test_result "Aliyun" "CURL_ERROR" "curl exit $curl_rc at $ALIYUN_STS_HOST"
    return 0
  fi

  if [[ "$status" == "200" ]]; then
    arn="$(json_field "$tmp" Arn)"
    account="$(json_field "$tmp" AccountId)"
    identity_type="$(json_field "$tmp" IdentityType)"
    rm -f "$tmp"
    printf "%-18s OK        %s (%s)%s\n" \
      "Aliyun" "${arn:-account $account}" "${identity_type:-unknown identity}" \
      "${arn:+  account: $account}"

    # IdentityType tells you what a valid key is worth risking. A RAM user's key
    # carries whatever policies it was given and can be revoked on its own; a root
    # key IS the account -- it cannot be scoped, no policy limits it, and it can
    # spend, delete and re-key everything in there. Both answer OK to this probe,
    # which is exactly why the difference has to be printed rather than implied.
    if [[ "$identity_type" == "Account" || "$arn" == *:root ]]; then
      printf "%-18s   WARNING: root-account AccessKey. Unscopable, unlimited over account %s.\n" \
        "" "$account"
      printf "%-18s   Alibaba Cloud's own guidance: use a RAM user's key and delete this one.\n" ""
    fi
    return 0
  fi

  code="$(json_field "$tmp" Code)"
  message="$(json_field "$tmp" Message)"
  rm -f "$tmp"

  # Unlike Webull, Alibaba Cloud says WHICH half is wrong, so pass its own word
  # through instead of flattening every refusal into one "check your credentials".
  case "$code" in
    SignatureDoesNotMatch)
      printf "%-18s FAIL      the key id exists; the SECRET (or the signing) is wrong\n" "Aliyun"
      ;;
    InvalidAccessKeyId.NotFound|InvalidAccessKeyId.Inactive)
      printf "%-18s FAIL      %s -- the key ID itself is unknown or disabled\n" "Aliyun" "$code"
      ;;
    *)
      print_test_result "Aliyun" "$status" "${code:-no code}${message:+: $message}"
      ;;
  esac
  return 0
}

http_test_exa() {
  local key status tmp curl_rc
  if ! key="$(get_key_or_env EXA_API_KEY)" || [[ -z "$key" ]]; then
    print_test_result "Exa Search" "MISSING"
    return 0
  fi

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
    -X POST -H "x-api-key: $key" -H "Content-Type: application/json" \
    --data '{"query":"ping","numResults":1}' \
    "https://api.exa.ai/search" 2>/dev/null)"
  curl_rc=$?
  set -e
  rm -f "$tmp"

  if [[ "$curl_rc" -ne 0 ]]; then
    print_test_result "Exa Search" "CURL_ERROR" "curl exit $curl_rc"
  else
    print_test_result "Exa Search" "$status"
  fi
}

# Tailscale ships two different credentials and only one of them is testable.
#
#   TAILSCALE_API_KEY  (tskey-api-...)  a normal bearer token -> probe it directly.
#   TAILSCALE_AUTHKEY  (tskey-auth-...) a node-enrollment credential. There is no
#                      endpoint that validates it; the only way to "use" it is to
#                      register a machine, which consumes a one-off key and adds a
#                      device. So we never spend it. Instead, when the API key is
#                      also present, we look the auth key up by its ID (the middle
#                      field of tskey-auth-<id>-<secret>) in GET /tailnet/-/keys,
#                      which proves it exists, and reports revoked/expired state.
#                      With no API key we can only check the shape and say so.
http_test_tailscale() {
  local api authkey status tmp curl_rc count keyid found

  api="$(get_key_or_env TAILSCALE_API_KEY 2>/dev/null || true)"
  authkey="$(get_key_or_env TAILSCALE_AUTHKEY 2>/dev/null || true)"

  if [[ -z "$api" ]]; then
    print_test_result "Tailscale API" "MISSING"
  else
    tmp="$(mktemp)"
    set +e
    status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
      -H "Authorization: Bearer $api" \
      "https://api.tailscale.com/api/v2/tailnet/-/devices" 2>/dev/null)"
    curl_rc=$?
    set -e
    if [[ "$curl_rc" -ne 0 ]]; then
      print_test_result "Tailscale API" "CURL_ERROR" "curl exit $curl_rc"
    elif [[ "$status" == "200" ]]; then
      count="$(grep -o '"nodeId"' "$tmp" | wc -l | tr -d ' ')"
      print_test_result "Tailscale API" "200"
      printf "%-18s   tailnet 有 %s 台设备\n" "" "$count"
    else
      print_test_result "Tailscale API" "$status"
    fi
    rm -f "$tmp"
  fi

  if [[ -z "$authkey" ]]; then
    print_test_result "Tailscale Auth" "MISSING"
    return 0
  fi

  case "$authkey" in
    tskey-auth-*) ;;
    *)
      printf "%-18s FAIL 前缀不是 tskey-auth-（API key 和 auth key 可能填反了）\n" "Tailscale Auth"
      return 0
      ;;
  esac

  if [[ -z "$api" ]]; then
    printf "%-18s SKIP 格式正确；没有 API key，无法在不消耗它的前提下验证\n" "Tailscale Auth"
    return 0
  fi

  # tskey-auth-<id>-<secret>; take the field between the 3rd and 4th dash.
  keyid="$(printf '%s' "$authkey" | cut -d- -f3)"
  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
    -H "Authorization: Bearer $api" \
    "https://api.tailscale.com/api/v2/tailnet/-/keys" 2>/dev/null)"
  curl_rc=$?
  set -e
  if [[ "$curl_rc" -ne 0 ]]; then
    print_test_result "Tailscale Auth" "CURL_ERROR" "curl exit $curl_rc"
  elif [[ "$status" != "200" ]]; then
    print_test_result "Tailscale Auth" "$status" "列举 keys 失败"
  else
    found=""
    grep -q "\"$keyid\"" "$tmp" && found=1
    if [[ -n "$found" ]]; then
      print_test_result "Tailscale Auth" "200"
      printf "%-18s   key id %s 在 tailnet 中存在（未消耗它）\n" "" "$keyid"
    else
      printf "%-18s FAIL key id %s 不在 tailnet 的 key 列表里（已撤销/过期/属于别的 tailnet）\n" \
        "Tailscale Auth" "$keyid"
    fi
  fi
  rm -f "$tmp"
}

# Every provider here answers GET /models with HTTP 200 for an account that can
# no longer serve a single token -- Kimi 403 "reached your usage limit", GLM 429
# code 1113 "余额不足", Anthropic 400 "credit balance is too low". Listing models
# proves only that the key authenticates, so every probe spends one real token
# before reporting OK, and the verdict comes from the body, not the status code
# (the three providers above use 403, 429 and 400 for the same condition).
is_quota_error() {
  grep -qiE '1113|余额不足|usage limit|insufficient balance|credit balance|resource package|out of credit|quota' "$1"
}

# Listing a model does not mean it can answer a chat completion: embeddings,
# audio, image and moderation models all appear in /models and would fail with a
# model-shaped error that has nothing to do with the key.
is_chat_model() {
  case "$(lower "$1")" in
    *embed*|*whisper*|*tts*|*audio*|*speech*|*dall-e*|*image*|*moderation*|*rerank*|*vision-only*)
      return 1 ;;
  esac
  return 0
}

# Spend one token against a root, trying a few models so a single unusable model
# is not mistaken for a dead key. Results come back in these globals.
CHAT_SERVED=""
CHAT_QUOTA=""
CHAT_DETAIL=""
CHAT_STATUS=""
try_chat_models() {
  local key="$1" root="$2" models="$3" limit="${4:-4}"
  local model tmp status curl_rc attempts=0

  CHAT_SERVED=""
  CHAT_QUOTA=""
  CHAT_DETAIL=""
  CHAT_STATUS=""

  for model in $models; do
    is_chat_model "$model" || continue
    [[ "$attempts" -ge "$limit" ]] && break
    attempts=$((attempts + 1))

    tmp="$(mktemp)"
    set +e
    status="$(curl -sS -m 60 -o "$tmp" -w "%{http_code}" \
      -X POST \
      -H "Authorization: Bearer $key" \
      -H "Content-Type: application/json" \
      --data "{\"model\":\"$model\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"max_tokens\":1}" \
      "$root/chat/completions" 2>/dev/null)"
    curl_rc=$?
    set -e

    if [[ "$curl_rc" -ne 0 ]]; then
      rm -f "$tmp"
      CHAT_STATUS="CURL_ERROR"
      CHAT_DETAIL="curl exit $curl_rc"
      continue
    fi

    CHAT_STATUS="$status"
    if [[ "$status" == "200" ]]; then
      rm -f "$tmp"
      CHAT_SERVED="$model"
      return 0
    fi

    if is_quota_error "$tmp"; then
      CHAT_QUOTA="$model"
    fi
    CHAT_DETAIL="$(api_error_message "$tmp")"
    rm -f "$tmp"
  done

  return 0
}

api_error_message() {
  local msg
  msg="$(grep -o '"message"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" | head -1 |
    sed 's/.*:[[:space:]]*"//; s/"$//')" || true
  printf '%.90s' "$msg"
}

all_model_ids() {
  local ids
  ids="$(grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' "$1" |
    sed 's/.*:[[:space:]]*"//; s/"$//')" || true
  printf '%s' "$ids"
}

json_field() {
  local value
  value="$(grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$1" | head -1 |
    sed 's/.*:[[:space:]]*"//; s/"$//')" || true
  printf '%s' "$value"
}

# Holding several accounts only buys headroom if they really are several
# accounts -- one account can issue many keys that share one quota, and two such
# keys look completely different. Kimi answers GET /me with the owning account,
# so `test` names it and cmd_test flags two slots that resolve to the same one.
# Empty means "this provider has no identity endpoint"; the caller sets it.
PROBE_IDENTITY_PATH=""
IDENTITY_SLOTS=()
IDENTITY_VALUES=()

account_identity() {
  local key="$1" url="$2"
  local tmp status ident

  [[ -z "$PROBE_IDENTITY_PATH" ]] && return 0

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 15 -o "$tmp" -w "%{http_code}" \
    -H "Authorization: Bearer $key" \
    "$url/$PROBE_IDENTITY_PATH" 2>/dev/null)"
  set -e

  if [[ "$status" != "200" ]]; then
    rm -f "$tmp"
    return 0
  fi

  ident="$(json_field "$tmp" email)"
  [[ -z "$ident" ]] && ident="$(json_field "$tmp" user_id)"
  rm -f "$tmp"
  printf '%s' "$ident"
}

record_identity() {
  local slot="$1" ident="$2"
  [[ -z "$ident" ]] && return 0
  IDENTITY_SLOTS[${#IDENTITY_SLOTS[@]}]="$slot"
  IDENTITY_VALUES[${#IDENTITY_VALUES[@]}]="$ident"
}

report_shared_accounts() {
  local i j
  i=0
  while [[ "$i" -lt "${#IDENTITY_VALUES[@]}" ]]; do
    j=$((i + 1))
    while [[ "$j" -lt "${#IDENTITY_VALUES[@]}" ]]; do
      if [[ "${IDENTITY_VALUES[$i]}" == "${IDENTITY_VALUES[$j]}" ]]; then
        printf '\nWarning: %s and %s are different keys on the SAME account (%s);\n' \
          "${IDENTITY_SLOTS[$i]}" "${IDENTITY_SLOTS[$j]}" "${IDENTITY_VALUES[$i]}"
        printf '         they share one quota, so holding both buys no headroom.\n'
      fi
      j=$((j + 1))
    done
    i=$((i + 1))
  done
}

# `test` writes for a human, but `pool` has to branch on the same probe, so every
# exit path records a machine-readable verdict beside the line it prints:
# OK / PARTIAL (served, but some model is out of quota) / NO_QUOTA / MISSING / FAIL.
PROBE_VERDICT=""

# Probe OpenAI-shaped roots in order; the first one that both authenticates the
# key and answers a completion is the api_root for that account.
probe_openai_roots() {
  local name="$1" env_name="$2"
  shift 2

  local key url status tmp curl_rc models detail ident
  local last_status="" last_detail=""

  PROBE_VERDICT="FAIL"

  if ! key="$(get_key_or_env "$env_name")" || [[ -z "$key" ]]; then
    PROBE_VERDICT="MISSING"
    print_test_result "$name" "MISSING"
    return 0
  fi

  for url in "$@"; do
    tmp="$(mktemp)"
    set +e
    status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
      -H "Authorization: Bearer $key" \
      "$url/models" 2>/dev/null)"
    curl_rc=$?
    set -e

    if [[ "$curl_rc" -ne 0 ]]; then
      rm -f "$tmp"
      last_status="CURL_ERROR"
      last_detail="curl exit $curl_rc at $url"
      continue
    fi

    if [[ "$status" != "200" ]]; then
      rm -f "$tmp"
      last_status="$status"
      last_detail="$url"
      continue
    fi

    models="$(all_model_ids "$tmp")"
    rm -f "$tmp"

    if [[ -z "$models" ]]; then
      last_status="$status"
      last_detail="$url returned no model id"
      continue
    fi

    try_chat_models "$key" "$url" "$models"

    if [[ "$CHAT_STATUS" == "CURL_ERROR" && -z "$CHAT_SERVED" ]]; then
      last_status="CURL_ERROR"
      last_detail="${CHAT_DETAIL} at $url"
      continue
    fi

    if [[ -n "$CHAT_SERVED" ]]; then
      ident="$(account_identity "$key" "$url")"
      record_identity "$name" "$ident"
      # Trying several models is what keeps an unusable first model from looking
      # like a dead key -- but it also means a free model can answer for an
      # account whose paid models are all refused, which is how `glm-4-flash`
      # certified a zero-balance GLM account for five days. If any model came
      # back with a quota error, that is part of the verdict, not a footnote.
      if [[ -n "$CHAT_QUOTA" ]]; then
        PROBE_VERDICT="PARTIAL"
        printf "%-18s PARTIAL   %s (served %s; %s is out of quota)%s\n" \
          "$name" "$url" "$CHAT_SERVED" "$CHAT_QUOTA" "${ident:+  account: $ident}"
      else
        PROBE_VERDICT="OK"
        printf "%-18s OK        %s (%s)%s\n" \
          "$name" "$url" "$CHAT_SERVED" "${ident:+  account: $ident}"
      fi
      return 0
    fi

    if [[ -n "$CHAT_QUOTA" ]]; then
      ident="$(account_identity "$key" "$url")"
      record_identity "$name" "$ident"
      PROBE_VERDICT="NO_QUOTA"
      printf "%-18s NO QUOTA  %s%s -- key is valid, account cannot serve: %s\n" \
        "$name" "$url" "${ident:+  account: $ident}" "$CHAT_DETAIL"
      return 0
    fi

    last_status="$CHAT_STATUS"
    last_detail="$url${CHAT_DETAIL:+: $CHAT_DETAIL}"
  done

  print_test_result "$name" "$last_status" "no root served the key; last $last_detail"
}

# Two DeepSeek keys are two pools of credit only if they are two accounts, and
# DeepSeek publishes no identity endpoint for record_identity to compare -- what it
# does answer is GET /user/balance. So print each slot's balance under its result
# and let two identical numbers speak for themselves; an equal balance is evidence
# of one shared account, not proof, so this never claims the verdict itself.
deepseek_balance() {
  local env_name="$1"
  local key tmp status currencies totals available line summary="" i
  local currency_list=() total_list=()

  key="$(get_key_or_env "$env_name")" || return 0
  [[ -z "$key" ]] && return 0

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 15 -o "$tmp" -w "%{http_code}" \
    -H "Authorization: Bearer $key" \
    "https://api.deepseek.com/user/balance" 2>/dev/null)"
  set -e

  if [[ "$status" != "200" ]]; then
    rm -f "$tmp"
    return 0
  fi

  # balance_infos is one entry per currency and USD comes first even when the
  # account holds no dollars, so reading a single field reports "USD 0.00" for an
  # account with CNY 88.62 in it (measured 2026-08-12). Zip every currency with
  # its own total instead: the values appear in document order, and within each
  # entry currency precedes total_balance, so the two lists line up.
  currencies="$(grep -o '"currency"[[:space:]]*:[[:space:]]*"[^"]*"' "$tmp" |
    sed 's/.*:[[:space:]]*"//; s/"$//')" || true
  totals="$(grep -o '"total_balance"[[:space:]]*:[[:space:]]*"[^"]*"' "$tmp" |
    sed 's/.*:[[:space:]]*"//; s/"$//')" || true
  available="$(grep -o '"is_available"[[:space:]]*:[[:space:]]*[a-z]*' "$tmp" |
    head -1 | sed 's/.*:[[:space:]]*//')" || true
  rm -f "$tmp"

  [[ -z "$totals" ]] && return 0

  while IFS= read -r line; do
    [[ -n "$line" ]] && currency_list[${#currency_list[@]}]="$line"
  done <<EOF
$currencies
EOF
  while IFS= read -r line; do
    [[ -n "$line" ]] && total_list[${#total_list[@]}]="$line"
  done <<EOF
$totals
EOF

  i=0
  while [[ "$i" -lt "${#total_list[@]}" ]]; do
    summary="${summary:+$summary, }${currency_list[$i]:-?} ${total_list[$i]}"
    i=$((i + 1))
  done

  if [[ "$available" == "false" ]]; then
    printf "%-18s   balance %s -- is_available false, this account cannot serve\n" \
      "" "$summary"
  else
    printf "%-18s   balance %s\n" "" "$summary"
  fi
  return 0
}

probe_deepseek() {
  probe_openai_roots "$1" "$2" "${DEEPSEEK_API_ROOTS[@]}"
  deepseek_balance "$2"
}

http_test_litellm() {
  local key base status tmp curl_rc detail

  if ! key="$(get_key_or_env LITELLM_API_KEY)" || [[ -z "$key" ]]; then
    print_test_result "LiteLLM" "MISSING"
    return 0
  fi

  base="$(get_key_or_env LITELLM_BASE_URL || true)"
  base="${base:-http://127.0.0.1:4000}"
  base="${base%/}"

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" \
    -H "Authorization: Bearer $key" \
    "$base/v1/models" 2>/dev/null)"
  curl_rc=$?
  set -e

  if [[ "$curl_rc" -ne 0 ]]; then
    rm -f "$tmp"
    print_test_result "LiteLLM" "CURL_ERROR" "curl exit $curl_rc at $base"
    return 0
  fi

  if [[ "$status" == "200" ]]; then
    local models count scope

    models="$(grep -o '"id"[[:space:]]*:[[:space:]]*"[^"]*"' "$tmp" |
      sed 's/.*:[[:space:]]*"//; s/"$//')" || true
    rm -f "$tmp"
    count="$(printf '%s\n' "$models" | grep -c . )" || true

    # /key/info is admin-gated, so it separates a full-access key from a virtual
    # one scoped to a few models -- both list models, only one manages keys.
    set +e
    status="$(curl -sS -m 25 -o /dev/null -w "%{http_code}" \
      -H "Authorization: Bearer $key" \
      "$base/key/info" 2>/dev/null)"
    set -e
    if [[ "$status" == "200" ]]; then
      scope="full access"
    else
      scope="/key/info HTTP $status, not full access"
    fi

    # A gateway is a fan-out: one upstream being out of quota does not make the
    # proxy or the key bad, so try a few models before calling it dead.
    try_chat_models "$key" "$base/v1" "$models"

    if [[ -n "$CHAT_SERVED" ]]; then
      printf "%-18s OK        %s (%s, %s models, served %s)%s\n" \
        "LiteLLM" "$base" "$scope" "$count" "$CHAT_SERVED" \
        "${CHAT_QUOTA:+ -- note: $CHAT_QUOTA upstream is out of quota}"
    elif [[ -n "$CHAT_QUOTA" ]]; then
      printf "%-18s NO QUOTA  %s (%s) -- no model served, %s upstream is out of quota\n" \
        "LiteLLM" "$base" "$scope" "$CHAT_QUOTA"
    else
      printf "%-18s FAIL      %s (%s) -- no model served: %s\n" \
        "LiteLLM" "$base" "$scope" "${CHAT_DETAIL:-unknown error}"
    fi
    return 0
  fi

  detail="$(api_error_message "$tmp")"
  rm -f "$tmp"
  print_test_result "LiteLLM" "$status" "$base${detail:+: $detail}"
}

# --------------------------------------------------------------------------------
# OPENBAO
#
# What goes wrong with a secret manager is not what goes wrong with an API key, so
# this probe reports a different set of facts:
#   - the SERVER can be sealed. /v1/sys/health needs no auth and encodes the state in
#     its status code, so ask it first: reporting a sealed server as a bad token
#     sends someone to rotate a credential that was never the problem.
#   - the TOKEN expires. A service token with a fixed expire_time is a scheduled
#     outage for everything that reads through it, so print the days left rather than
#     a bare OK, and say so out loud under two weeks.
#   - the POLICY may not grant what its name suggests. lookup-self returns policy
#     NAMES, which is not the same as access, so also LIST the shared record path and
#     report how many records the token can really see.
# The token reaches curl through a 0600 config file, never argv, and is never printed.
# --------------------------------------------------------------------------------
BAO_RECORD_PATH="secret/metadata/shared/llm"

# env -> Keychain -> ~/.api-keys-bao, so a machine already configured for
# `pool --sync-bao` needs no second setup and either source alone is enough.
bao_addr() {
  local addr
  addr="$(get_key_or_env BAO_ADDR 2>/dev/null || true)"
  if [[ -z "$addr" ]]; then
    pool_bao_config
    addr="$POOL_BAO_ADDR"
  fi
  printf '%s' "${addr%/}"
}

bao_token() {
  local token
  token="$(get_key_or_env BAO_TOKEN 2>/dev/null || true)"
  if [[ -z "$token" ]]; then
    pool_bao_config
    if [[ -n "$POOL_BAO_TOKEN_FILE" && -r "$POOL_BAO_TOKEN_FILE" ]]; then
      token="$(tr -d '\r\n' <"$POOL_BAO_TOKEN_FILE")"
    fi
  fi
  printf '%s' "$token"
}

# expire_time is RFC3339 carrying nanoseconds ("2026-09-13T04:17:04.109259215Z"),
# which `date -j -f` will not parse -- cut the fraction and any zone suffix off.
bao_days_left() {
  local stamp="$1" epoch now
  stamp="${stamp%%.*}"
  stamp="${stamp%%Z*}"
  stamp="${stamp%%+*}"
  [[ -z "$stamp" ]] && return 1
  epoch="$(TZ=UTC date -j -f '%Y-%m-%dT%H:%M:%S' "$stamp" '+%s' 2>/dev/null)" || return 1
  now="$(date '+%s')"
  printf '%d' "$(( (epoch - now) / 86400 ))"
}

http_test_openbao() {
  local addr token cfg tmp status curl_rc detail
  local version display policies expire days records state

  addr="$(bao_addr)"

  if [[ -z "$addr" ]]; then
    printf "%-18s MISSING   no address saved (api_keys set bao_addr)\n" "OpenBao"
    return 0
  fi

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" "$addr/v1/sys/health" 2>/dev/null)"
  curl_rc=$?
  set -e

  if [[ "$curl_rc" -ne 0 ]]; then
    rm -f "$tmp"
    print_test_result "OpenBao" "CURL_ERROR" "curl exit $curl_rc at $addr"
    return 0
  fi

  version="$(json_field "$tmp" version)"
  rm -f "$tmp"

  # The status code IS the state; the body would need a JSON bool parser to say the
  # same thing less reliably.
  case "$status" in
    200) state="unsealed, active" ;;
    429) state="unsealed, standby" ;;
    472|473) state="unsealed, replication standby" ;;
    501)
      printf "%-18s FAIL      %s is not initialized\n" "OpenBao" "$addr"
      return 0
      ;;
    503)
      printf "%-18s SEALED    %s is sealed -- unseal it; no token can read it\n" \
        "OpenBao" "$addr"
      return 0
      ;;
    *)
      print_test_result "OpenBao" "$status" "$addr/v1/sys/health"
      return 0
      ;;
  esac

  token="$(bao_token)"
  if [[ -z "$token" ]]; then
    printf "%-18s MISSING   %s is up (%s) but no token saved\n" \
      "OpenBao" "$addr" "$state"
    return 0
  fi

  cfg="$(mktemp)"
  chmod 600 "$cfg"
  printf 'header = "X-Vault-Token: %s"\n' "$token" >"$cfg"

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" --config "$cfg" \
    "$addr/v1/auth/token/lookup-self" 2>/dev/null)"
  set -e

  if [[ "$status" != "200" ]]; then
    detail="$(api_error_message "$tmp")"
    printf "%-18s FAIL      %s refused this token: HTTP %s%s\n" \
      "OpenBao" "$addr" "$status" "${detail:+ ($detail)}"
    rm -P "$cfg" "$tmp" 2>/dev/null || rm -f "$cfg" "$tmp"
    return 0
  fi

  display="$(json_field "$tmp" display_name)"
  expire="$(json_field "$tmp" expire_time)"
  policies="$(grep -o '"policies"[[:space:]]*:[[:space:]]*\[[^]]*\]' "$tmp" | head -1 |
    sed 's/.*\[//; s/\]//; s/"//g; s/,/, /g')" || true
  rm -P "$tmp" 2>/dev/null || rm -f "$tmp"

  # Policy names are a claim; a LIST is the evidence.
  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" --config "$cfg" \
    -X LIST "$addr/v1/$BAO_RECORD_PATH" 2>/dev/null)"
  set -e
  rm -P "$cfg" 2>/dev/null || rm -f "$cfg"

  if [[ "$status" == "200" ]]; then
    records="$(grep -o '"keys"[[:space:]]*:[[:space:]]*\[[^]]*\]' "$tmp" | head -1 |
      sed 's/.*\[//; s/\]//; s/"//g; s/,/, /g')" || true
  else
    records=""
  fi
  rm -P "$tmp" 2>/dev/null || rm -f "$tmp"

  printf "%-18s OK        %s (v%s, %s)\n" "OpenBao" "$addr" "${version:-?}" "$state"
  printf "%-18s   token %s, policies %s\n" "" "${display:-unnamed}" "${policies:-none}"

  if [[ -n "$expire" ]]; then
    if days="$(bao_days_left "$expire")"; then
      if [[ "$days" -lt 0 ]]; then
        printf "%-18s   EXPIRED %s -- every consumer of this token is already broken\n" \
          "" "${expire%%T*}"
      elif [[ "$days" -lt 14 ]]; then
        printf "%-18s   expires %s, %s days left -- renew it before it strands its readers\n" \
          "" "${expire%%T*}" "$days"
      else
        printf "%-18s   expires %s (%s days)\n" "" "${expire%%T*}" "$days"
      fi
    else
      printf "%-18s   expires %s\n" "" "$expire"
    fi
  else
    printf "%-18s   no expiry\n" ""
  fi

  if [[ -n "$records" ]]; then
    printf "%-18s   reads %s: %s\n" "" "${BAO_RECORD_PATH#secret/metadata/}" "$records"
  else
    printf "%-18s   cannot LIST %s (HTTP %s) -- the token is valid but reads nothing there\n" \
      "" "$BAO_RECORD_PATH" "$status"
  fi

  return 0
}

# Empty TEST_FILTER means "run everything"; otherwise it holds the space-delimited
# env names selected on the command line.
TEST_FILTER=""
want() {
  local name

  [[ -z "$TEST_FILTER" ]] && return 0

  for name in "$@"; do
    case "$TEST_FILTER" in
      *" $name "*) return 0 ;;
    esac
  done

  return 1
}

cmd_test() {
  local item

  if [[ "$#" -gt 0 ]]; then
    select_items "$@"
    TEST_FILTER=" "
    for item in "${SELECTED[@]}"; do
      TEST_FILTER="$TEST_FILTER${item##*:} "
    done
  fi

  echo "Testing saved keys. No secrets will be printed."

  want OPENAI_API_KEY &&
    probe_openai_roots "OpenAI" "OPENAI_API_KEY" "https://api.openai.com/v1"
  want ANTHROPIC_API_KEY &&
    http_get_anthropic
  want DEEPSEEK_API_KEY &&
    probe_deepseek "DeepSeek 1" "DEEPSEEK_API_KEY"
  want DEEPSEEK_API_KEY_2 &&
    probe_deepseek "DeepSeek 2" "DEEPSEEK_API_KEY_2"
  want GLM_API_KEY &&
    probe_openai_roots "GLM/Zhipu" "GLM_API_KEY" "${GLM_PLATFORM_API_ROOTS[@]}"
  want GLM_CODING_API_KEY &&
    probe_openai_roots "GLM Coding 1" "GLM_CODING_API_KEY" "${GLM_CODING_API_ROOTS[@]}"
  want GLM_CODING_API_KEY_2 &&
    probe_openai_roots "GLM Coding 2" "GLM_CODING_API_KEY_2" "${GLM_CODING_API_ROOTS[@]}"
  PROBE_IDENTITY_PATH="me"
  want KIMI_API_KEY &&
    probe_openai_roots "Kimi Code 1" "KIMI_API_KEY" "${KIMI_API_ROOTS[@]}"
  want KIMI_API_KEY_2 &&
    probe_openai_roots "Kimi Code 2" "KIMI_API_KEY_2" "${KIMI_API_ROOTS[@]}"
  want KIMI_API_KEY_3 &&
    probe_openai_roots "Kimi Code 3" "KIMI_API_KEY_3" "${KIMI_API_ROOTS[@]}"
  PROBE_IDENTITY_PATH=""
  want LITELLM_API_KEY LITELLM_BASE_URL &&
    http_test_litellm
  want NOTION_API_KEY &&
    http_get_bearer "Notion" "NOTION_API_KEY" "https://api.notion.com/v1/users/me" \
      -H "Notion-Version: 2026-03-11"
  want LARK_APP_ID LARK_APP_SECRET &&
    http_test_lark
  want FIREWORKS_API_KEY &&
    probe_openai_roots "Fireworks" "FIREWORKS_API_KEY" "https://api.fireworks.ai/inference/v1"
  # api.minimax.io rejects this key outright; the live roots are minimaxi.com
  # and minimax.chat, so probe rather than hardcode the wrong one.
  want MINIMAX_API_KEY &&
    probe_openai_roots "MiniMax" "MINIMAX_API_KEY" "${MINIMAX_API_ROOTS[@]}"
  want EXA_API_KEY &&
    http_test_exa
  want TAVILY_API_KEY &&
    http_post_json_bearer "Tavily Search" "TAVILY_API_KEY" \
      "https://api.tavily.com/search" '{"query":"ping","max_results":1}'
  want ALIBABA_CLOUD_ACCESS_KEY_ID ALIBABA_CLOUD_ACCESS_KEY_SECRET &&
    http_test_aliyun
  want WEBULL_APP_KEY WEBULL_APP_SECRET &&
    http_test_webull
  want TAILSCALE_API_KEY TAILSCALE_AUTHKEY &&
    http_test_tailscale
  want BAO_ADDR BAO_TOKEN &&
    http_test_openbao

  report_shared_accounts

  return 0
}

# --------------------------------------------------------------------------------
# POOL
#
# Several keys for one provider only buy anything if something picks a live one.
# A consumer should read ONE name -- DEEPSEEK_API_KEY -- and the slots behind it
# (_2, _3) should be this tool's business, not theirs. `pool` probes the slots of
# each multi-slot family in order and binds the canonical name to a slot that can
# serve right now, so an exhausted account stops being a thing anyone edits by hand.
#
# WHAT IS CACHED IS THE DECISION, NEVER THE SECRET. The cache holds a slot name, a
# truncated digest and a timestamp; the value itself is re-read from the Keychain at
# emit time. That also makes rotation self-detecting: replacing a key changes its
# digest, which invalidates the entry without anyone remembering to say so.
#
# `export` stays literal -- it dumps what is stored, one line per slot -- because a
# command that reports storage and a command that resolves a pool should not be the
# same command. `eval "$(api_keys pool)"` is the drop-in for consumers.
# --------------------------------------------------------------------------------
POOL_CACHE_FILE="${API_KEYS_POOL_CACHE:-$HOME/.api-keys-pool}"
POOL_TTL_SECS="${API_KEYS_POOL_TTL_SECS:-43200}"

# Slot 2 of DEEPSEEK_API_KEY is DEEPSEEK_API_KEY_2, so a family is its members
# minus a trailing _<n>. Nothing else in NAMES ends in _<digit>.
pool_base_of() {
  case "$1" in
    *_[0-9]) printf '%s' "${1%_[0-9]}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# Members of one family in slot order -- NAMES lists the canonical name before its
# numbered siblings, so document order is slot order.
pool_members() {
  local base="$1" item env_name
  for item in "${NAMES[@]}"; do
    env_name="${item##*:}"
    [[ "$(pool_base_of "$env_name")" == "$base" ]] && printf '%s\n' "$env_name"
  done
  return 0
}

pool_label_of() {
  local env_name="$1" item
  for item in "${NAMES[@]}"; do
    if [[ "${item##*:}" == "$env_name" ]]; then
      printf '%s' "${item%%:*}"
      return 0
    fi
  done
  printf '%s' "$env_name"
}

# A family is only probed if we know what a live key of that provider answers.
# Anything else resolves to its first saved slot without spending a token -- the
# honest thing to do when the tool has no evidence, and it keeps `pool` a drop-in
# for `export` on the single-slot entries.
pool_probe() {
  local base="$1" env_name="$2" label="$3"

  case "$base" in
    DEEPSEEK_API_KEY)
      probe_deepseek "$label" "$env_name"
      ;;
    KIMI_API_KEY)
      PROBE_IDENTITY_PATH="me"
      probe_openai_roots "$label" "$env_name" "${KIMI_API_ROOTS[@]}"
      PROBE_IDENTITY_PATH=""
      ;;
    GLM_CODING_API_KEY)
      probe_openai_roots "$label" "$env_name" "${GLM_CODING_API_ROOTS[@]}"
      ;;
    GLM_API_KEY)
      probe_openai_roots "$label" "$env_name" "${GLM_PLATFORM_API_ROOTS[@]}"
      ;;
    *)
      PROBE_VERDICT="UNPROBED"
      ;;
  esac
  return 0
}

pool_is_usable() {
  case "$1" in
    OK|PARTIAL|UNPROBED) return 0 ;;
  esac
  return 1
}

POOL_WINNER=""
POOL_VERDICT=""
POOL_TRACE=""
POOL_SOURCE=""

pool_probe_family() {
  local base="$1"
  local member label verdict

  POOL_WINNER=""
  POOL_VERDICT=""
  POOL_TRACE=""

  while IFS= read -r member; do
    [[ -z "$member" ]] && continue
    label="$(pool_label_of "$member")"

    if ! has_key "$member"; then
      POOL_TRACE="${POOL_TRACE:+$POOL_TRACE; }$label missing"
      continue
    fi

    pool_probe "$base" "$member" "$label" >&2
    verdict="$PROBE_VERDICT"
    POOL_TRACE="${POOL_TRACE:+$POOL_TRACE; }$label $verdict"

    if pool_is_usable "$verdict"; then
      POOL_WINNER="$member"
      POOL_VERDICT="$verdict"
      return 0
    fi
  done <<EOF
$(pool_members "$base")
EOF

  return 1
}

# Cache line: base <TAB> winner <TAB> digest <TAB> epoch <TAB> verdict
pool_cache_read() {
  local base="$1" want_fresh="$2"
  local line f_base f_winner f_digest f_epoch f_verdict now age

  POOL_WINNER=""
  POOL_VERDICT=""

  [[ -r "$POOL_CACHE_FILE" ]] || return 1
  now="$(date +%s)"

  while IFS="$(printf '\t')" read -r f_base f_winner f_digest f_epoch f_verdict; do
    [[ "$f_base" == "$base" ]] || continue
    case "$f_epoch" in ''|*[!0-9]*) continue ;; esac

    # A slot whose key was replaced since the decision is a different slot as far as
    # this cache is concerned, so re-probe rather than hand out a stale winner.
    has_key "$f_winner" || return 1
    [[ "$(digest_of "$(get_key "$f_winner")")" == "$f_digest" ]] || return 1

    age=$((now - f_epoch))
    if [[ "$want_fresh" == "fresh" && "$age" -ge "$POOL_TTL_SECS" ]]; then
      return 1
    fi

    POOL_WINNER="$f_winner"
    POOL_VERDICT="$f_verdict"
    POOL_AGE="$age"
    return 0
  done <"$POOL_CACHE_FILE"

  return 1
}

pool_cache_write() {
  local base="$1" winner="$2" verdict="$3"
  local tmp digest

  digest="$(digest_of "$(get_key "$winner")")"
  tmp="$(mktemp)"

  if [[ -r "$POOL_CACHE_FILE" ]]; then
    grep -v "^$base$(printf '\t')" "$POOL_CACHE_FILE" >"$tmp" 2>/dev/null || true
  fi
  printf '%s\t%s\t%s\t%s\t%s\n' "$base" "$winner" "$digest" "$(date +%s)" "$verdict" >>"$tmp"

  # The cache names slots, not secrets, but it still describes this machine's key
  # inventory, so it is nobody else's business either.
  mv "$tmp" "$POOL_CACHE_FILE"
  chmod 600 "$POOL_CACHE_FILE"
  return 0
}

# Where the shared secret manager lives is a property of one deployment, not of
# this script, and this repository is public -- so nothing about it is hardcoded.
# The first-class place for it is now the BAO_ADDR / BAO_TOKEN Keychain slots
# (`api_keys set bao`), which is also what `api_keys test bao` checks. This file
# stays supported for a token that must live outside the Keychain -- a shared or
# root-owned deployment credential -- and for machines set up before those slots
# existed. Env overrides both:
#   addr=https://bao.example.internal
#   token_file=~/.config/api_keys/bao-token
POOL_BAO_CONFIG="${API_KEYS_BAO_CONFIG:-$HOME/.api-keys-bao}"
POOL_BAO_ADDR="${API_KEYS_BAO_ADDR:-}"
POOL_BAO_TOKEN_FILE="${API_KEYS_BAO_TOKEN_FILE:-}"

pool_bao_config() {
  local line name value

  [[ -r "$POOL_BAO_CONFIG" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim "${line%$'\r'}")"
    [[ -z "$line" ]] && continue
    case "$line" in \#*) continue ;; esac
    [[ "$line" == *"="* ]] || continue

    name="$(lower "$(trim "${line%%=*}")")"
    value="$(trim "${line#*=}")"
    value="${value/#\~/$HOME}"

    case "$name" in
      addr) [[ -z "$POOL_BAO_ADDR" ]] && POOL_BAO_ADDR="$value" ;;
      token_file) [[ -z "$POOL_BAO_TOKEN_FILE" ]] && POOL_BAO_TOKEN_FILE="$value" ;;
    esac
  done <"$POOL_BAO_CONFIG"

  return 0
}

# Which families the shared secret manager carries, and under which record. A
# family absent from this table is never written -- adding a row is the deliberate
# act that makes `pool --sync-bao` willing to touch a company-wide secret.
pool_bao_record() {
  case "$1" in
    DEEPSEEK_API_KEY) printf 'deepseek' ;;
    KIMI_API_KEY) printf 'kimi' ;;
    GLM_API_KEY) printf 'glm' ;;
    *) return 1 ;;
  esac
  return 0
}

json_escape() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  printf '%s' "$value"
}

json_number() {
  local value
  value="$(grep -o "\"$2\"[[:space:]]*:[[:space:]]*[0-9][0-9]*" "$1" | head -1 |
    sed 's/.*:[[:space:]]*//')" || true
  printf '%s' "$value"
}

# Push the pool winner into the shared record, but only when it is measurably the
# better key: an unusable winner is never published, an already-current record is
# left alone, and the write carries cas=<current version> so a concurrent update
# aborts instead of being clobbered. KV v2 keeps the previous value as the previous
# version, which is the rollback. Values and the token never reach argv or stdout.
pool_sync_bao() {
  local base="$1" winner="$2" verdict="$3"
  local record addr token cfg tmp body status version digest_local digest_remote

  record="$(pool_bao_record "$base")" || {
    printf 'pool: %s has no shared record; nothing to sync\n' "$base" >&2
    return 0
  }

  # Same resolution as `test`: env, then the BAO_ADDR/BAO_TOKEN Keychain slots, then
  # ~/.api-keys-bao. One place to configure the manager, whichever one you picked.
  addr="$(bao_addr)"
  token="$(bao_token)"

  if [[ -z "$addr" ]]; then
    printf 'pool: no secret manager configured; api_keys set bao_addr, or set\n' >&2
    printf '      API_KEYS_BAO_ADDR, or write addr= in %s\n' "$POOL_BAO_CONFIG" >&2
    return 1
  fi

  if ! pool_is_usable "$verdict" || [[ "$verdict" == "UNPROBED" ]]; then
    printf 'pool: %s winner is %s, refusing to publish it to %s\n' \
      "$base" "${verdict:-unknown}" "$record" >&2
    return 1
  fi

  if [[ -z "$token" ]]; then
    printf 'pool: no OpenBao token (api_keys set bao_token); %s not synced\n' "$record" >&2
    return 1
  fi

  cfg="$(mktemp)"
  chmod 600 "$cfg"
  # curl --config keeps the bearer out of argv, where `ps` would show it.
  printf 'header = "X-Vault-Token: %s"\n' "$token" >"$cfg"

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" --config "$cfg" \
    "$addr/v1/secret/data/shared/llm/$record" 2>/dev/null)"
  set -e

  if [[ "$status" != "200" ]]; then
    printf 'pool: read of shared/llm/%s returned HTTP %s; not synced\n' "$record" "$status" >&2
    rm -P "$cfg" "$tmp" 2>/dev/null || rm -f "$cfg" "$tmp"
    return 1
  fi

  version="$(json_number "$tmp" version)"
  digest_remote="$(digest_of "$(json_field "$tmp" api_key)")"
  digest_local="$(digest_of "$(get_key "$winner")")"
  rm -P "$tmp" 2>/dev/null || rm -f "$tmp"

  if [[ "$digest_remote" == "$digest_local" ]]; then
    printf 'pool: shared/llm/%s already holds %s (sha256:%s), v%s\n' \
      "$record" "$winner" "$digest_local" "$version" >&2
    rm -P "$cfg" 2>/dev/null || rm -f "$cfg"
    return 0
  fi

  body="$(mktemp)"
  chmod 600 "$body"
  printf '{"data":{"api_key":"%s"},"options":{"cas":%s}}' \
    "$(json_escape "$(get_key "$winner")")" "${version:-0}" >"$body"

  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" --config "$cfg" \
    -X PATCH -H "Content-Type: application/merge-patch+json" \
    --data-binary "@$body" \
    "$addr/v1/secret/data/shared/llm/$record" 2>/dev/null)"
  set -e
  rm -P "$body" 2>/dev/null || rm -f "$body"

  if [[ "$status" != "200" ]]; then
    printf 'pool: PATCH shared/llm/%s returned HTTP %s (%s); nothing changed\n' \
      "$record" "$status" "$(api_error_message "$tmp")" >&2
    rm -P "$cfg" "$tmp" 2>/dev/null || rm -f "$cfg" "$tmp"
    return 1
  fi
  rm -P "$tmp" 2>/dev/null || rm -f "$tmp"

  # A 200 on the write is not evidence the record now serves the right key: read it
  # back and compare digests, the same check `import` does for the Keychain.
  tmp="$(mktemp)"
  set +e
  status="$(curl -sS -m 25 -o "$tmp" -w "%{http_code}" --config "$cfg" \
    "$addr/v1/secret/data/shared/llm/$record" 2>/dev/null)"
  set -e
  rm -P "$cfg" 2>/dev/null || rm -f "$cfg"

  digest_remote="$(digest_of "$(json_field "$tmp" api_key)")"
  version="$(json_number "$tmp" version)"
  rm -P "$tmp" 2>/dev/null || rm -f "$tmp"

  if [[ "$digest_remote" == "$digest_local" ]]; then
    printf 'pool: shared/llm/%s <- %s (sha256:%s), now v%s (previous value kept as v%s)\n' \
      "$record" "$winner" "$digest_local" "$version" "$((version - 1))" >&2
    return 0
  fi

  printf 'pool: read-back of shared/llm/%s does not match (%s != %s)\n' \
    "$record" "$digest_remote" "$digest_local" >&2
  return 1
}

POOL_AGE=""
cmd_pool() {
  local refresh=0 sync=0 emit=1
  local bases="" base item env_name winner verdict source rc=0

  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --refresh) refresh=1; shift ;;
      --sync-bao) sync=1; shift ;;
      --force) FORCE_STDOUT=1; shift ;;
      --) shift; break ;;
      -*)
        printf 'Unknown option: %s\n' "$1" >&2
        exit 2
        ;;
      *) break ;;
    esac
  done

  select_items "$@"

  # The selection still runs and still reports on stderr -- knowing WHICH slot is
  # live is the answer most callers actually want, and it carries no secret.
  if stdout_is_recorded; then
    emit=0
    refuse_stdout pool
  fi

  for item in "${SELECTED[@]}"; do
    env_name="${item##*:}"
    base="$(pool_base_of "$env_name")"
    case " $bases " in
      *" $base "*) ;;
      *) bases="$bases $base" ;;
    esac
  done

  for base in $bases; do
    winner=""
    verdict=""
    source=""
    POOL_AGE=""

    # One saved slot and nothing to choose between: no probe, no token spent.
    if [[ "$(pool_members "$base" | grep -c .)" -le 1 ]]; then
      if [[ "$emit" -eq 1 ]] && has_key "$base"; then
        printf "export %s=%s\n" "$base" "$(shell_quote "$(get_key "$base")")"
      fi
      continue
    fi

    if [[ "$refresh" -eq 0 ]] && pool_cache_read "$base" fresh; then
      winner="$POOL_WINNER"
      verdict="$POOL_VERDICT"
      source="cached ${POOL_AGE}s ago"
    elif pool_probe_family "$base"; then
      winner="$POOL_WINNER"
      verdict="$POOL_VERDICT"
      source="probed -- $POOL_TRACE"
      pool_cache_write "$base" "$winner" "$verdict"
    elif pool_cache_read "$base" stale; then
      # Every slot failed its probe just now. That is usually the provider or this
      # laptop's network, not four dead accounts, so the last known-good decision is
      # a better answer than none -- said out loud, never silently.
      winner="$POOL_WINNER"
      verdict="$POOL_VERDICT"
      source="STALE cache (${POOL_AGE}s old); no slot answered just now"
      rc=1
    elif has_key "$base"; then
      winner="$base"
      verdict="UNKNOWN"
      source="fallback to slot 1; no slot is usable"
      rc=1
    else
      printf 'pool: %-18s no usable slot and none saved\n' "$base" >&2
      rc=1
      continue
    fi

    [[ "$emit" -eq 1 ]] &&
      printf "export %s=%s\n" "$base" "$(shell_quote "$(get_key "$winner")")"
    printf 'pool: %-20s -> %s (%s) %s\n' \
      "$base" "$winner" "$verdict" "$source" >&2

    if [[ "$sync" -eq 1 ]]; then
      pool_sync_bao "$base" "$winner" "$verdict" || rc=1
    fi
  done

  return "$rc"
}

cmd_delete() {
  local item env_name

  select_items "$@"

  for item in "${SELECTED[@]}"; do
    env_name="${item##*:}"
    if has_key "$env_name"; then
      security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$env_name" >/dev/null
      echo "Deleted $env_name"
    else
      echo "Missing $env_name"
    fi
  done
}

case "${1:-}" in
  set) shift; cmd_set "$@" ;;
  template) shift; cmd_template "$@" ;;
  import) shift; cmd_import "$@" ;;
  export) shift; cmd_export "$@" ;;
  pool) shift; cmd_pool "$@" ;;
  test) shift; cmd_test "$@" ;;
  list) shift; cmd_list "$@" ;;
  delete) shift; cmd_delete "$@" ;;
  -h|--help|help|"") usage ;;
  *)
    usage >&2
    exit 2
    ;;
esac
